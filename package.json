{
  "name": "@edsolater/uikit",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "description": "SolidJS 基础组件与 hooks 组件库",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css/*": "./dist/css/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@edsolater/fnkit": "link:@edsolater/fnkit",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "solid-js": "^1.9.12",
    "storybook": "^10.3.5",
    "storybook-solidjs-vite": "^10.0.12",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vite-plugin-solid": "^2.11.8",
    "vite-plugin-lib-inject-css": "^2.2.2"
  }
}
